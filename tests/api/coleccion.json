              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@vidriera.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuario/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuario", "login"]
            }
          }
        }
      ]
