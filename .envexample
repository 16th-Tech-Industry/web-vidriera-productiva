# Base PostgreSQL. En Railway la define sola el servicio PostgreSQL; en local,
# la de docker compose o la que uses (ver db/README.md).
DATABASE_URL=postgresql://usuario:password@localhost:5432/vidriera
# Pool de conexiones (opcionales, tienen default en db_connector.py)
DB_POOL_MIN=2
DB_POOL_MAX=10
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# URL pública del backend, para armar la URL de las imágenes
# (/api/v1/imagenes/{id}, ver api/v1/servicios/imagenes.py)
PUBLIC_BASE_URL=http://localhost:8000
# URL del backend que usa el frontend (ver frontend/src/config.ts).
# En un despliegue va la URL pública del backend.
VITE_API_URL=http://localhost:8000
# Envío de mails (ver backend/api/v1/servicios/correo.py). En desarrollo van
# los datos SMTP de la casilla de pruebas de Mailtrap (Sandbox > SMTP Settings).
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Córdoba Vidriera Productiva <no-responder@vidrieraproductiva.local>
# URL pública del frontend, para armar los links que van dentro de los mails.
FRONTEND_URL=http://localhost:5173
